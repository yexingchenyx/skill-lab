# Tests for the <module-name> module.
file(GLOB <MODULE_NAME_UPPER>_TEST_SOURCES CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/*.cpp)
add_executable(${PROJECT_NAME}_<module-name>_tests ${<MODULE_NAME_UPPER>_TEST_SOURCES})
target_link_libraries(${PROJECT_NAME}_<module-name>_tests
  PRIVATE ${PROJECT_NAME}::test_common GTest::gtest_main)

include(GoogleTest)
gtest_discover_tests(${PROJECT_NAME}_<module-name>_tests)
