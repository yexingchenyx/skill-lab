// Shared test utility implementations. Add common helpers here.
#include "<project-name>/tests/util.hpp"

#include <sstream>

namespace <namespace-macro>_NS::tests {

std::string join(const std::vector<std::string>& parts, const std::string& sep) {
    std::ostringstream oss;
    for (std::size_t i = 0; i < parts.size(); ++i) {
        if (i > 0) oss << sep;
        oss << parts[i];
    }
    return oss.str();
}

std::string repeat(const std::string& s, int n) {
    std::string result;
    result.reserve(s.size() * (n > 0 ? static_cast<std::size_t>(n) : 0));
    for (int i = 0; i < n; ++i) result += s;
    return result;
}

}  // namespace <namespace-macro>_NS::tests
