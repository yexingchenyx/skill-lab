# cli/common: shared CLI utilities library.
# Links CLI11 (command-line parsing) and the project aggregate library.
file(GLOB CLI_COMMON_SOURCES CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp)
add_library(cli_common STATIC ${CLI_COMMON_SOURCES})
target_include_directories(cli_common PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
target_link_libraries(cli_common PUBLIC
  CLI11::CLI11
  ${PROJECT_NAME}::${PROJECT_NAME}_lib)
add_library(${PROJECT_NAME}::cli_common ALIAS cli_common)
