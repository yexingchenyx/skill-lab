// Build-time configuration, generated by CMake from cmake/config.h.in.
// Do not edit directly — edit cmake/config.h.in instead.
#pragma once

// NOTE: every token inside @...@ below is a CMake configure_file variable
// with a FIXED name (PROJECT_*) that contains no template placeholders.
// Placeholder replacement (cp, CP, ...)
// can therefore never touch these @...@ tokens.
#define CP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CP_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CP_VERSION "@PROJECT_VERSION@"

// Unified C++ namespace for all modules (default set in cmake/options.cmake;
// override via CMakePresets.json "base" preset or -DCP_NAMESPACE=...).
// Use as namespace name: namespace CP_NS { ... }
// or in string contexts: CP_NS_NAME
#define CP_NS @CP_NAMESPACE@
#define CP_NS_NAME "@CP_NAMESPACE@"

// Build options
#cmakedefine01 CP_BUILD_TESTS
#cmakedefine01 CP_WARNINGS_AS_ERRORS

// Build type: CP_DEBUG is 1 in Debug builds, 0 otherwise.
#define CP_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define CP_DEBUG @PROJECT_DEBUG@

// Build metadata (set in cmake/common.cmake)
#define CP_GIT_COMMIT "@PROJECT_GIT_COMMIT@"
#define CP_BUILD_TIME "@PROJECT_BUILD_TIME@"

// ---------------------------------------------------------------------------
// Unified library export macro (shared by ALL modules).
// Each module defines CP_EXPORTS (PRIVATE) while building
// itself; CP_STATIC_DEFINE (set when BUILD_SHARED_LIBS=OFF)
// disables dllexport/dllimport entirely for static builds/consumption.
// ---------------------------------------------------------------------------
#if defined(_WIN32) || defined(__CYGWIN__)
#  ifdef CP_STATIC_DEFINE
#    define CP_API
#  elif defined(CP_EXPORTS)
     /* We are building one of this project's libraries */
#    define CP_API __declspec(dllexport)
#  else
     /* We are consuming this project's libraries */
#    define CP_API __declspec(dllimport)
#  endif
#else
#  if __GNUC__ >= 4
#    define CP_API __attribute__((visibility("default")))
#  else
#    define CP_API
#  endif
#endif
